# Provenance-based allowlist: 기본 전부 무시 → 손-콘텐츠만 opt-in
# 런타임이 새 디렉토리를 만들어도 기본이 ignore라 노이즈 재유입 없음
/*

# 코어 파일
!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/settings.json

# 발표자료
!/PRESENTATION.pdf

# 손으로 작성한 규칙·메모리 템플릿
!/rules/
!/memory-templates/

# 훅: 디렉토리 opt-in → 전체 무시 → .sh만 재opt-in
!/hooks/
/hooks/*
!/hooks/*.sh

# 스크립트: sync-memory-templates.sh + install.sh(Plan B 예정, forward-compat)
!/scripts/
/scripts/*
!/scripts/sync-memory-templates.sh
!/scripts/install.sh

# 설계 스펙 + compound 학습: docs opt-in → specs·solutions(생성물 plans는 계속 무시)
!/docs/
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
!/docs/solutions/

# 손-작성 스킬: 디렉토리 opt-in → 전체 무시 → 손-콘텐츠만 재opt-in
# (나머지 skills/*는 설치·생성물이라 계속 무시)
!/skills/
/skills/*
!/skills/hybrid-workflow-reference/
!/skills/fastapi-project-structure/
!/skills/python-architecture/
# SKILL.md 백업본은 생성물 → 재무시 (디렉토리 opt-in 뒤에 와야 적용됨)
/skills/fastapi-project-structure/SKILL.md.bak

# doc 스킬 명령어: 디렉토리 opt-in → 전체 무시 → 3개 스킬만 재opt-in
!/commands/
/commands/*
!/commands/tag-doc.md
!/commands/translate-doc.md
!/commands/banner-doc.md

# doc 스킬 에셋: 손-콘텐츠만 opt-in
# tag-doc·banner-doc은 순수 마크다운
!/tag-doc-assets/
!/banner-doc-assets/
# translate-doc은 Python 코드 → 캐시·생성물 제외 위해 .md/.py/testdata만 재opt-in
!/translate-doc-assets/
/translate-doc-assets/*
!/translate-doc-assets/*.md
!/translate-doc-assets/*.py
!/translate-doc-assets/testdata/
