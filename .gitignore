# Provenance-based allowlist: 기본 전부 무시 → 손-콘텐츠만 opt-in
# 런타임이 새 디렉토리를 만들어도 기본이 ignore라 노이즈 재유입 없음
/*

# 코어 파일
!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/settings.json

# 발표자료
!/PRESENTATION.pdf

# 손으로 작성한 규칙·메모리 템플릿, 출력 스타일
!/rules/
!/memory-templates/
!/output-styles/

# 훅: 디렉토리 opt-in → 전체 무시 → .sh만 재opt-in
!/hooks/
/hooks/*
!/hooks/*.sh

# 스크립트: sync-memory-templates.sh + install.sh(Plan B 예정, forward-compat)
# + git-filter-settings.sh(settings.json 로컬 블록 clean/smudge 필터)
!/scripts/
/scripts/*
!/scripts/sync-memory-templates.sh
!/scripts/install.sh
!/scripts/git-filter-settings.sh

# local-hooks.json은 위 /* 로 이미 무시된다 -- smudge 필터의 복원 원본이므로
# 이 머신에서만 존재하고, 삭제하면 checkout 후 grrr 훅이 사라진다.

# 설계 스펙 + 학습 기록: docs opt-in → specs·solutions
# (plans는 공개 저장소라 무시 -- 삭제 금지 규칙은 그대로 적용되며 워킹트리에만 존재한다)
!/docs/
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
!/docs/solutions/

# 손-작성 스킬: 디렉토리 opt-in → 전체 무시 → 손-콘텐츠만 재opt-in
# (나머지 skills/*는 설치·생성물이라 계속 무시)
!/skills/
/skills/*
!/skills/capturing-learnings/
!/skills/fastapi-project-structure/
!/skills/python-architecture/
!/skills/python-coding-style/
!/skills/translate-doc/
# translate-doc의 assets는 Python 코드 → 캐시·생성물 제외 위해 .md/.py/testdata만 재opt-in
# (glossary.json은 외부 저장소로 가는 심링크라 계속 미추적)
/skills/translate-doc/assets/*
!/skills/translate-doc/assets/*.md
!/skills/translate-doc/assets/*.py
!/skills/translate-doc/assets/testdata/
# 번역 메모장: 축적된 판단이고 이 저장소는 Vault가 아니라 git이 유일한 안전망
!/skills/translate-doc/assets/translation-memo.jsonl
# SKILL.md 백업본은 생성물 → 재무시 (디렉토리 opt-in 뒤에 와야 적용됨)
/skills/fastapi-project-structure/SKILL.md.bak

# doc 스킬 명령어: 디렉토리 opt-in → 전체 무시 → 2개 커맨드만 재opt-in
# (translate-doc은 커맨드에서 스킬로 옮겨 위 skills/ 절에서 opt-in한다)
!/commands/
/commands/*
!/commands/tag-doc.md
!/commands/banner-doc.md

# doc 스킬 에셋: 손-콘텐츠만 opt-in
# tag-doc·banner-doc은 순수 마크다운
!/tag-doc-assets/
!/banner-doc-assets/
